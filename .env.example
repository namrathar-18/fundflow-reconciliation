# FundFlow Environment Configuration
# Copy this file to .env and adjust variables as needed

# Django Backend
SECRET_KEY=your-production-secret-key-replace-this
DEBUG=False
ALLOWED_HOSTS=*

# Database (PostgreSQL)
USE_SQLITE=False
DB_NAME=fundflow
DB_USER=postgres
DB_PASSWORD=your_secure_password_here
DB_HOST=db
DB_PORT=5432

# Optional Frontend Override (leave unset to use internal reverse proxy)
# VITE_API_URL=http://localhost:8000/api
